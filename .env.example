# Frontend configuration for PesaSense-AI (Vite).

# Where the Vite dev server forwards API calls (/users, /transactions,
# /budgets, /reports). The FastAPI backend runs here in development.
# Port 8000 is usually taken by another service on this machine, so use 8010.
# Change this if you start the backend on a different port.
VITE_PROXY_TARGET=http://127.0.0.1:8010

# Only set this if the API lives on a different origin than the frontend
# (e.g. a deployed backend). Leave empty in development so requests stay
# same-origin and go through the Vite proxy above.
# VITE_API_BASE_URL=